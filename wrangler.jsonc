{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roots-ecommerce",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Serve static assets (CSS, fonts, _next/static, /public) from Cloudflare's edge
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  // Optional: R2 bucket for ISR / fetch cache. Uncomment after you've
  // created the bucket: `npx wrangler r2 bucket create grain-roots-cache`
  // Without this, cache is in-memory per-Worker-instance (still functional).
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "grain-roots-cache"
  //   }
  // ],

  // Public (non-secret) env vars. Secrets are set via:
  //   npx wrangler secret put DATABASE_URL
  //   npx wrangler secret put JWT_SECRET
  //   ... etc
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Grain Roots",
    // Canonical site URL — used by sitemap.xml, robots.txt, JSON-LD, OG tags,
    // payment return URLs and WhatsApp product links.
    "NEXT_PUBLIC_APP_URL": "https://www.grainroots.com.np",
    // Analytics / ad pixels — baked in at build time. Add Meta/TikTok ids here
    // too when you start advertising on those platforms.
    "NEXT_PUBLIC_GA_ID": "G-WK4G4WBP1V",
    // Order/chat channels. Messenger/Instagram use the account username.
    // Add NEXT_PUBLIC_WHATSAPP_NUMBER / _VIBER_NUMBER (digits only) to enable those.
    "NEXT_PUBLIC_MESSENGER_USERNAME": "grainrootsfood",
    "NEXT_PUBLIC_INSTAGRAM_USERNAME": "grainrootsfood"
  },

  "observability": {
    "enabled": true
  }
}

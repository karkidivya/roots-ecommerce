# Local wrangler dev env vars. Copy to .dev.vars (gitignored) for local Cloudflare testing.
# In production, set these via `wrangler secret put <NAME>` or the Cloudflare dashboard.

DATABASE_URL="your_neon_postgres_url"
JWT_SECRET="long_random_string_min_32_chars"
ADMIN_PASSWORD="your_admin_password"

# Cloudinary (public ones can stay in wrangler.jsonc vars; secret goes here)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dlk4mtgle"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="nepal_shop_unsigned"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Payments (production keys go to Cloudflare secrets)
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="..."
KHALTI_SECRET_KEY="..."
NEXT_PUBLIC_KHALTI_PUBLIC_KEY="..."
FONEPAY_MERCHANT_CODE="..."
FONEPAY_SECRET_KEY="..."

# Email
RESEND_API_KEY="..."
RESEND_FROM_EMAIL="orders@yourdomain.com"

# Order/chat channels. WhatsApp/Viber: digits only. Messenger/Instagram: username.
NEXT_PUBLIC_WHATSAPP_NUMBER="9779800000000"
NEXT_PUBLIC_VIBER_NUMBER=""
NEXT_PUBLIC_MESSENGER_USERNAME="grainrootsfood"
NEXT_PUBLIC_INSTAGRAM_USERNAME="grainrootsfood"

# Analytics / ad pixels (NEXT_PUBLIC_* are inlined at BUILD time — for
# Cloudflare, put these in wrangler.jsonc "vars" or the build environment,
# not just as runtime secrets).
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# Database (Neon Postgres - https://neon.tech)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Nepal Shop"

# Admin auth (simple password-based; change before deploying)
ADMIN_PASSWORD=changeme_admin_password
JWT_SECRET=generate_a_long_random_string_at_least_32_chars_long

# Cloudinary (https://cloudinary.com - free 25GB)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=nepal_shop_unsigned

# eSewa (https://developer.esewa.com.np)
# Sandbox credentials - replace with production from merchant dashboard
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_VERIFY_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Khalti (https://docs.khalti.com)
# Sandbox credentials - replace with production
KHALTI_SECRET_KEY=your_khalti_secret_key
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=your_khalti_public_key
KHALTI_GATEWAY_URL=https://dev.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://dev.khalti.com/api/v2/epayment/lookup/

# Fonepay (https://merchant.fonepay.com)
FONEPAY_MERCHANT_CODE=your_merchant_code
FONEPAY_SECRET_KEY=your_secret_key
FONEPAY_GATEWAY_URL=https://dev-clientapi.fonepay.com/api/merchantRequest

# Resend (https://resend.com - free 3k emails/month)
# Order confirmation emails send only when BOTH of these are set.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=orders@yourdomain.com

# Optional: SMS via Sparrow SMS (https://sparrowsms.com)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Order/chat channels — each button in the floating widget appears only when set.
# WhatsApp/Viber: full international number, digits only, e.g. 9779800000000.
# Messenger/Instagram: the account username, e.g. grainrootsfood.
# (TikTok has no click-to-message link, so it can't be an order channel.)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_VIBER_NUMBER=
NEXT_PUBLIC_MESSENGER_USERNAME=
NEXT_PUBLIC_INSTAGRAM_USERNAME=

# Analytics / ad pixels — each loads only when its ID is set. All optional.
NEXT_PUBLIC_GA_ID=              # GA4 measurement id, e.g. G-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=      # Facebook/Meta pixel id (numbers)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=    # TikTok pixel id
